    "/administrador/livros": {
      "post": {
        "tags": [
          "Livros Admin"
        ],
        "summary": "Cadastra um livro",
        "description": "Realiza o cadastro de um novo livro.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "titulo": {
                  "type": "string",
                  "example": "O Senhor dos Anéis"
                },
                "isbn": {
                  "type": "string",
                  "example": "978-0-345-33968-9"
                },
                "preco": {
                  "type": "number",
                  "example": 29.99
                },
                "autor": {
                  "type": "string",
                  "example": "J.R.R. Tolkien"
                },
                "editora": {
                  "type": "string",
                  "example": "HarperCollins"
                },
                "categoria": {
                  "type": "string",
                  "example": "Fantasia"
                },
                "capa": {
                  "type": "string",
                  "example": "https://example.com/capa.jpg"
                },
                "descricao": {
                  "type": "string",
                  "example": "Um clássico da literatura fantástica."
                },
                "anoPublicacao": {
                  "type": "number",
                  "example": 1954
                },
                "estoque": {
                  "type": "number",
                  "example": 10
                },
                "adminId": {
                  "type": "number",
                  "example": 1
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Livro cadastrado com sucesso."
          },
          "400": {
            "description": "Dados inválidos."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
